<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MySQL Data</title>
    <style>
        body {
            background-color: #B5BF79;
            font-family: Arial;
            text-align: center;
        }
        table {
            width: 80%;
            border-collapse: collapse;
            margin: 20px auto;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: center;
        }
        th {
            background-color: #f2f2f2;
        }
    </style>
</head>
<!-- ------------------------------------------------- -->
<body>
        <h1>Edit the person below:</h1>
        <%= data[0].grade + " " + data[0].name %>
        <br><br>
        <form method="POST" action="/<%= data[0].service_number %>?_method=PUT">
            <table>
                <thead>
                    <tr>
                        <th>Service Number</th>
                        <th>Grade</th>
                        <th>Name</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <input type="text" name="service_number" value="<%= data[0].service_number %>" required>
                        </td>
                        <td>
                            <input type="text" name="grade" value="<%= data[0].grade %>" required>
                        </td>
                        <td>
                            <input type="text" name="name" value="<%= data[0].name %>" required>
                        </td>
                    </tr>
                </tbody>
            </table>
            <br><br>
            <div class="button-group">
                <button type="submit" class="btn-confirm">Confirm</button>
                <a href="/" class="btn-cancel">Cancel</a>
            </div>
        </form>
<br><br><br><br><br><br><br><br><br><br>
<!-- ------------------------------------------------- -->

</body>
</html>
